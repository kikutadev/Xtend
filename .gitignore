# Exclude credentials, dependencies, and generated files
.DS_Store
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx
*.mobileprovision
*.keystore
**/node_modules/
**/.venv/
**/venv/
**/__pycache__/
**/.build/
**/DerivedData/
**/.cache/
**/tmp/
**/.tmp/

**/.wrangler/
**/*.xcuserstate

# Local IDE data and credentials
**/xcuserdata/
*.ipa
*.xcarchive/

# Never commit personal/private extension binaries. Embedded only for explicit local builds.
Xtend/LocalExtensions/
